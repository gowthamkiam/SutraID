{
  "name": "@sutraid/backend",
  "version": "0.1.0",
  "description": "SutraID Backend API - AI-native CIAM platform",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "postinstall": "prisma generate",
    "vercel-build": "npx prisma generate && npx @nestjs/cli build",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:cov": "jest --config jest.config.js --coverage",
    "test:e2e": "jest --config jest.config.js test/app.e2e-spec.ts",
    "test:unit": "jest --config jest.config.js --testPathIgnorePatterns=e2e",
    "clean": "rm -rf dist",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/throttler": "^6.5.0",
    "@node-saml/passport-saml": "^5.1.0",
    "@prisma/client": "^5.8.0",
    "@simplewebauthn/server": "^13.2.3",
    "@types/passport": "^1.0.17",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "escape-html": "^1.0.3",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "jose": "^5.10.0",
    "node-forge": "^1.3.3",
    "oidc-provider": "^9.6.0",
    "openid-client": "^5.7.1",
    "otpauth": "^9.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^5.8.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.14",
    "resend": "^3.0.0",
    "rxjs": "^7.8.1",
    "samlify": "^2.10.2",
    "xml2js": "^0.6.2",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/escape-html": "^1.0.4",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.5",
    "@types/node-forge": "^1.3.14",
    "@types/passport-jwt": "^4.0.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
