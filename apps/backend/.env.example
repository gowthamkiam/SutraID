# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (Neon.tech FREE tier)
DATABASE_URL="postgresql://user:password@your-neon-host.neon.tech/sutraid?sslmode=require"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Email Service (Resend FREE tier - 3K emails/month)
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="noreply@sutraid.com"

# Frontend URLs
FRONTEND_URL="http://localhost:3001"
MAGIC_LINK_BASE_URL="http://localhost:3001/auth/verify"

# Optional: Redis (Upstash FREE tier - for sessions/rate limiting)
# REDIS_URL="redis://default:your_password@your-redis.upstash.io:6379"

# Optional: Twilio (for SMS OTP - trial credits)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""
