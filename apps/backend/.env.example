# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (local PostgreSQL or Neon)
# For local Docker/Postgres:
#   POSTGRES_DB, POSTGRES_USER and POSTGRES_PASSWORD are configured in docker-compose.yml
#   DATABASE_URL will typically look like:
#   postgresql://sutraid:change_me@localhost:5432/sutraid
DATABASE_URL="postgresql://sutraid:change_me@localhost:5432/sutraid"

# Optional: direct connection string for migrations if using a managed provider like Neon
DIRECT_DATABASE_URL="postgresql://user:password@your-neon-host.neon.tech/your-db?sslmode=require"

# JWT Configuration
JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Email Service (Resend - do NOT commit real keys)
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="noreply@example.com"

# Frontend URLs (used for CORS and magic links)
FRONTEND_URL="http://localhost:3001"
ADMIN_DASHBOARD_URL="http://localhost:3001"
MAGIC_LINK_BASE_URL="http://localhost:3001/auth/verify"
BACKEND_URL="http://localhost:3000"

# Encryption key for sensitive data (SAML private keys, etc.)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your_32_byte_hex_key_here"

# Optional: Redis (Upstash or other provider)
# REDIS_URL="redis://default:your_password@your-redis.upstash.io:6379"

# Optional: Twilio (for SMS OTP)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""
