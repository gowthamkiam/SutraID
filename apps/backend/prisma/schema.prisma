// SutraID - Prisma Schema
// Simplified schema for prototype (User authentication only)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ============================================================================
// CORE TABLES (Prototype)
// ============================================================================

// User table - Core user identity
model User {
  id                String   @id @default(uuid())
  email             String   @unique
  emailVerified     Boolean  @default(false)
  emailVerifiedAt   DateTime?

  // Profile
  firstName         String?
  lastName          String?
  avatarUrl         String?

  // Password (nullable — passwordless users don't have one)
  passwordHash      String?
  passwordChangedAt DateTime?

  // Status
  status            UserStatus @default(ACTIVE)
  lastLoginAt       DateTime?

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  authChallenges    AuthChallenge[]
  sessions          Session[]
  organizationMembers OrganizationMember[]
  ssoIdentities     SsoIdentity[]

  @@index([email])
  @@index([status])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// AuthChallenge - For passwordless authentication (magic links, OTP)
model AuthChallenge {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Challenge details
  type              ChallengeType
  token             String   @unique  // Hashed token for magic links, or OTP code
  identifier        String            // Email or phone number used

  // Verification
  verified          Boolean  @default(false)
  verifiedAt        DateTime?
  attempts          Int      @default(0)
  maxAttempts       Int      @default(3)

  // Expiration
  expiresAt         DateTime

  // Metadata
  ipAddress         String?
  userAgent         String?

  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("auth_challenges")
}

enum ChallengeType {
  MAGIC_LINK
  EMAIL_OTP
  SMS_OTP
  PASSWORD_RESET
}

// Session - User session management
model Session {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Session tokens
  accessToken       String   @unique  // JWT ID (jti claim)
  refreshToken      String   @unique  // Hashed refresh token

  // Device info
  deviceId          String?
  deviceName        String?
  deviceType        String?
  ipAddress         String?
  userAgent         String?
  location          String?

  // Status
  revoked           Boolean  @default(false)
  revokedAt         DateTime?
  revokedReason     String?

  // Expiration
  expiresAt         DateTime
  lastActiveAt      DateTime @default(now())

  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([accessToken])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================================
// MULTI-TENANCY (Phase 1 - Enterprise Features)
// ============================================================================

// Organization (Tenant) - Multi-tenant entity
model Organization {
  id                String   @id @default(uuid())

  // Basic info
  name              String
  slug              String   @unique  // URL-safe identifier
  domain            String?  @unique  // Primary verified domain

  // Branding
  logoUrl           String?
  primaryColor      String   @default("#000000")

  // Settings
  allowedDomains    String[]  // Email domains that can auto-join

  // Subscription & Limits
  plan              OrgPlan  @default(FREE)
  status            OrgStatus @default(ACTIVE)
  maxMembers        Int      @default(10)
  maxApplications   Int      @default(3)

  // SAML Identity Provider (Phase 3)
  samlIdpCertificate String?  // X.509 certificate for signing SAML assertions
  samlIdpPrivateKey  String?  // Private key (encrypted with AES-256-GCM)

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  members           OrganizationMember[]
  applications      Application[]
  ssoProviders      SsoProvider[]

  @@index([slug])
  @@index([domain])
  @@map("organizations")
}

enum OrgPlan {
  FREE
  STARTER
  BUSINESS
  ENTERPRISE
}

enum OrgStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  DELETED
}

// Organization Member - Users belonging to organizations with roles
model OrganizationMember {
  id                String   @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Role-based access control
  role              OrgRole  @default(MEMBER)

  // Status
  status            MemberStatus @default(ACTIVE)
  invitedBy         String?  // UserId who sent invitation
  invitedAt         DateTime?
  joinedAt          DateTime @default(now())

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

enum OrgRole {
  OWNER      // Full control, billing, delete org
  ADMIN      // Manage members, apps, policies
  DEVELOPER  // Manage apps and integrations
  MEMBER     // Read-only access
}

enum MemberStatus {
  ACTIVE
  PENDING_INVITATION
  SUSPENDED
}

// Application - Apps that organizations want to protect
model Application {
  id                String   @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // App details
  name              String
  description       String?
  logoUrl           String?

  // OAuth/OIDC settings
  clientId          String   @unique
  clientSecret      String   // Encrypted
  redirectUris      String[] // Allowed redirect URIs
  allowedOrigins    String[] // CORS origins

  // App type
  type              AppType  @default(WEB)

  // Status
  status            AppStatus @default(ACTIVE)

  // SAML Identity Provider Configuration (Phase 3)
  samlIdpEnabled     Boolean  @default(false)  // Enable this app to use us as SAML IDP
  samlSpEntityId     String?  // External SP's Entity ID
  samlSpAcsUrl       String?  // External SP's Assertion Consumer Service URL
  samlNameIdFormat   String?  // NameID format (default: emailAddress)
  samlAttributeMapping Json?  // Map our attributes to SP's expected attributes

  // OIDC Identity Provider Configuration (Phase 3)
  oidcIdpEnabled     Boolean  @default(false)  // Enable this app to use us as OIDC IDP
  oidcScopes         String[] @default(["openid", "profile", "email"])  // Allowed scopes

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
  @@map("applications")
}

enum AppType {
  WEB           // Traditional web app
  SPA           // Single-page application
  NATIVE_MOBILE // iOS/Android
  NATIVE_DESKTOP // Desktop app
  M2M           // Machine-to-machine
}

enum AppStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

// ============================================================================
// SSO (Phase 2 - External Identity Providers)
// ============================================================================

// SSO Provider - External SAML/OIDC identity providers
model SsoProvider {
  id                String   @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Provider details
  name              String
  type              SsoProviderType
  protocol          SsoProtocol

  // SAML Configuration
  samlEntityId      String?  // SAML Entity ID (IdP)
  samlSsoUrl        String?  // SAML Single Sign-On URL
  samlCertificate   String?  // X.509 Certificate (encrypted)
  samlMetadataUrl   String?  // SAML Metadata URL

  // OIDC Configuration
  oidcIssuer        String?  // OIDC Issuer URL
  oidcClientId      String?  // OIDC Client ID
  oidcClientSecret  String?  // OIDC Client Secret (encrypted)
  oidcAuthUrl       String?  // Authorization endpoint
  oidcTokenUrl      String?  // Token endpoint
  oidcUserinfoUrl   String?  // UserInfo endpoint
  oidcScopes        String[] @default(["openid", "profile", "email"])

  // Attribute Mapping (JSON)
  // Maps external attributes to internal user fields
  // Example: { "email": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress" }
  attributeMapping  Json     @default("{}")

  // Settings
  enabled           Boolean  @default(true)
  autoProvision     Boolean  @default(true)  // Auto-create users on first login
  allowedDomains    String[] @default([])    // Restrict to specific email domains

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  identities        SsoIdentity[]

  @@index([organizationId])
  @@index([organizationId, enabled])
  @@map("sso_providers")
}

enum SsoProviderType {
  OKTA
  AZURE_AD
  GOOGLE_WORKSPACE
  GENERIC_SAML
  GENERIC_OIDC
}

enum SsoProtocol {
  SAML2
  OIDC
}

// SSO Identity - Links users to external SSO identities
model SsoIdentity {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ssoProviderId     String
  ssoProvider       SsoProvider @relation(fields: [ssoProviderId], references: [id], onDelete: Cascade)

  // External identity details
  externalId        String   // Subject ID from IdP (sub claim or NameID)
  externalEmail     String?  // Email from IdP
  issuer            String   // Issuer URL or Entity ID

  // Attributes from IdP (JSON)
  attributes        Json     @default("{}")

  // First and last login tracking
  firstLoginAt      DateTime @default(now())
  lastLoginAt       DateTime @default(now())

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([ssoProviderId, externalId])
  @@index([userId])
  @@index([ssoProviderId])
  @@map("sso_identities")
}

// ============================================================================
// OIDC IDENTITY PROVIDER (Phase 3)
// ============================================================================

// OidcToken - Stores OIDC Provider tokens (authorization codes, access tokens, etc.)
// Used by oidc-provider library
model OidcToken {
  id                String   @id @default(uuid())
  organizationId    String

  // Token type (AuthorizationCode, AccessToken, RefreshToken, etc.)
  type              String

  // Token identifier (from oidc-provider)
  tokenId           String

  // Serialized payload (JSON)
  payload           String   @db.Text

  // Expiration
  expiresAt         DateTime

  // Consumption tracking
  consumed          Boolean  @default(false)
  consumedAt        DateTime?

  createdAt         DateTime @default(now())

  @@unique([organizationId, type, tokenId])
  @@index([organizationId, type])
  @@index([expiresAt])
  @@map("oidc_tokens")
}

