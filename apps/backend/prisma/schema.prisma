generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                     String                      @id @default(uuid())
  email                  String                      @unique
  organizationId         String?
  role                   OrgRole                     @default(READ_ONLY_ADMIN)
  emailVerified          Boolean                     @default(false)
  emailVerifiedAt        DateTime?
  firstName              String?
  lastName               String?
  avatarUrl              String?
  passwordHash           String?
  passwordChangedAt      DateTime?
  mustChangePassword     Boolean                     @default(false)
  status                 UserStatus                  @default(ACTIVE)
  lastLoginAt            DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  mfaEnabled             Boolean                     @default(false)
  externalId             String?
  agentMetadata          Json?
  authChallenges         AuthChallenge[]
  groups                 GroupMember[]
  mfaMethods             MfaMethod[]
  organizationMembers    OrganizationMember[]
  sessions               Session[]
  ssoIdentities          SsoIdentity[]
  applicationAssignments UserApplicationAssignment[]
  userGroups             UserGroup[]
  organization           Organization?               @relation(fields: [organizationId], references: [id])

  @@index([email])
  @@index([organizationId])
  @@index([status])
  @@index([externalId])
  @@map("users")
}

model DirectoryConfig {
  id               String        @id @default(uuid())
  organizationId   String        @unique
  type             DirectoryType @default(SCIM)
  enabled          Boolean       @default(true)
  scimToken        String?
  ldapUrl          String?
  ldapBaseDn       String?
  ldapBindDn       String?
  ldapBindPassword String?
  ldapUserFilter   String?       @default("(objectClass=user)")
  ldapGroupFilter  String?       @default("(objectClass=group)")
  syncInterval     Int           @default(60)
  lastSyncAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("directory_configs")
}

model Group {
  id                     String                       @id @default(uuid())
  organizationId         String
  name                   String
  description            String?
  externalId             String?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  applicationAssignments GroupApplicationAssignment[]
  members                GroupMember[]
  organization           Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userGroups             UserGroup[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([externalId])
  @@map("groups")
}

model UserGroup {
  userId    String
  groupId   String
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
  @@index([userId])
  @@map("user_groups")
}

model GroupMember {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("group_members")
}

model AuthChallenge {
  id          String        @id @default(uuid())
  userId      String
  type        ChallengeType
  token       String        @unique
  identifier  String
  verified    Boolean       @default(false)
  verifiedAt  DateTime?
  attempts    Int           @default(0)
  maxAttempts Int           @default(3)
  expiresAt   DateTime
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("auth_challenges")
}

model Session {
  id            String    @id @default(uuid())
  userId        String
  accessToken   String    @unique
  refreshToken  String    @unique
  deviceId      String?
  deviceName    String?
  deviceType    String?
  ipAddress     String?
  userAgent     String?
  location      String?
  revoked       Boolean   @default(false)
  revokedAt     DateTime?
  revokedReason String?
  expiresAt     DateTime
  lastActiveAt  DateTime  @default(now())
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accessToken])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("sessions")
}

model Organization {
  id                 String                @id @default(uuid())
  name               String                @unique
  slug               String                @unique
  domain             String?               @unique
  logoUrl            String?
  primaryColor       String                @default("#000000")
  allowedDomains     String[]
  plan               OrgPlan               @default(FREE)
  status             OrgStatus             @default(ACTIVE)
  maxMembers         Int                   @default(10)
  maxApplications    Int                   @default(3)
  samlIdpCertificate String?
  samlIdpPrivateKey  String?
  customLoginConfig  Json?
  mfaRequired        Boolean               @default(false)
  mfaGracePeriodDays Int                   @default(7)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  applications       Application[]
  directoryConfig    DirectoryConfig?
  groups             Group[]
  networkZones       NetworkZone[]
  members            OrganizationMember[]
  settings           OrganizationSetting[]
  passwordPolicies   PasswordPolicy?
  policies           Policy[]
  ssoProviders       SsoProvider[]
  users              User[]

  @@index([slug])
  @@index([domain])
  @@map("organizations")
}

model OrganizationSetting {
  id             String       @id @default(uuid())
  organizationId String
  key            String
  value          String
  updatedBy      String?
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("organization_settings")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           OrgRole      @default(READ_ONLY_ADMIN)
  status         MemberStatus @default(ACTIVE)
  invitedBy      String?
  invitedAt      DateTime?
  joinedAt       DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model Application {
  id                      String                       @id @default(uuid())
  organizationId          String
  name                    String
  description             String?
  logoUrl                 String?
  type                    ApplicationProtocol          @default(OIDC)
  clientId                String?                      @unique
  clientSecretHash        String?
  redirectUris            Json                         @default("[]")
  grantTypes              Json                         @default("[\"authorization_code\", \"refresh_token\"]")
  responseTypes           Json                         @default("[\"code\"]")
  scopes                  Json                         @default("[\"openid\", \"profile\", \"email\", \"offline_access\"]")
  tokenEndpointAuthMethod String                       @default("client_secret_post")
  isPublicClient          Boolean                      @default(false)
  requireDpop             Boolean                      @default(false)
  jwks                    Json?
  dpopNonceEnabled        Boolean                      @default(true)
  isAiAgent               Boolean                      @default(false)
  aiAgentMetadata         Json?
  allowROPC               Boolean                      @default(false)
  allowClientCredentials  Boolean                      @default(false)
  allowRefreshForROPC     Boolean                      @default(false)
  pkceRequired            Boolean                      @default(true)
  samlEntityId            String?
  samlCertificate         String?
  samlPrivateKey          String?
  samlSpEntityId          String?
  samlSpAcsUrl            String?
  samlNameIdFormat        String?                      @default("urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress")
  samlAttributeMapping    Json?
  status                  AppStatus                    @default(ACTIVE)
  createdBy               String?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  organization            Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  groupAssignments        GroupApplicationAssignment[]
  oidcClaims              OidcClaim[]
  oidcRegexRules          OidcRegexRule[]
  oidcScopes              OidcScope[]
  oidcSigningKeys         OidcSigningKey[]
  oidcTokenPolicy         OidcTokenPolicy?
  userAssignments         UserApplicationAssignment[]

  @@index([organizationId])
  @@index([clientId])
  @@map("applications")
}

model UserApplicationAssignment {
  id            String      @id @default(uuid())
  userId        String
  applicationId String
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, applicationId])
  @@index([applicationId])
  @@index([userId])
  @@map("user_application_assignments")
}

model GroupApplicationAssignment {
  id            String      @id @default(uuid())
  groupId       String
  applicationId String
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  group         Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, applicationId])
  @@index([applicationId])
  @@index([groupId])
  @@map("group_application_assignments")
}

model SsoProvider {
  id               String          @id @default(uuid())
  organizationId   String
  name             String
  type             SsoProviderType
  protocol         SsoProtocol
  samlEntityId     String?
  samlSsoUrl       String?
  samlCertificate  String?
  samlMetadataUrl  String?
  oidcIssuer       String?
  oidcClientId     String?
  oidcClientSecret String?
  oidcAuthUrl      String?
  oidcTokenUrl     String?
  oidcUserinfoUrl  String?
  oidcScopes       String[]        @default(["openid", "profile", "email"])
  attributeMapping Json            @default("{}")
  enabled          Boolean         @default(true)
  autoProvision    Boolean         @default(true)
  allowedDomains   String[]        @default([])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  identities       SsoIdentity[]
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, enabled])
  @@map("sso_providers")
}

model SsoIdentity {
  id            String      @id @default(uuid())
  userId        String
  ssoProviderId String
  externalId    String
  externalEmail String?
  issuer        String
  attributes    Json        @default("{}")
  firstLoginAt  DateTime    @default(now())
  lastLoginAt   DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  ssoProvider   SsoProvider @relation(fields: [ssoProviderId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ssoProviderId, externalId])
  @@index([userId])
  @@index([ssoProviderId])
  @@map("sso_identities")
}

model OidcToken {
  id             String    @id @default(uuid())
  organizationId String
  applicationId  String
  type           String
  tokenId        String
  payload        String
  expiresAt      DateTime
  consumed       Boolean   @default(false)
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@unique([organizationId, applicationId, type, tokenId])
  @@index([organizationId, applicationId, type])
  @@index([expiresAt])
  @@map("oidc_tokens")
}

model Policy {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  type           PolicyType   @default(ACCESS)
  effect         PolicyEffect @default(ALLOW)
  resource       String       @default("*")
  actions        String[]     @default([])
  rules          Json         @default("[]")
  conditions     Json         @default("{}")
  priority       Int          @default(0)
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, enabled])
  @@map("policies")
}

model PasswordPolicy {
  id               String       @id @default(uuid())
  organizationId   String       @unique
  minLength        Int          @default(8)
  requireUppercase Boolean      @default(true)
  requireLowercase Boolean      @default(true)
  requireNumbers   Boolean      @default(true)
  requireSymbols   Boolean      @default(true)
  maxAgeDays       Int          @default(0)
  historyCount     Int          @default(5)
  lockoutThreshold Int          @default(5)
  lockoutDuration  Int          @default(30)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("password_policies")
}

model NetworkZone {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  ipRanges       String[]
  geoLocations   String[]
  trusted        Boolean      @default(false)
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("network_zones")
}

model AuditLog {
  id             String      @id @default(uuid())
  organizationId String?
  userId         String?
  agentId        String?
  action         String
  resource       String?
  result         AuditResult @default(SUCCESS)
  metadata       Json        @default("{}")
  riskScore      Float?
  createdAt      DateTime    @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
  @@index([result])
  @@map("audit_logs")
}

model MfaMethod {
  id               String    @id @default(uuid())
  userId           String
  type             MfaType   @default(TOTP)
  name             String    @default("Authenticator App")
  totpSecret       String?
  totpEncryptionIv String?
  totpAuthTag      String?
  backupCodes      String[]
  verified         Boolean   @default(false)
  enabled          Boolean   @default(true)
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, enabled])
  @@map("mfa_methods")
}

model OidcScope {
  id            String      @id @default(uuid())
  applicationId String
  name          String
  description   String?
  isDefault     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, name])
  @@index([applicationId])
  @@map("oidc_scopes")
}

model OidcClaim {
  id            String         @id @default(uuid())
  applicationId String
  name          String
  userAttribute String
  regexRuleId   String?
  targetTokens  ClaimTarget[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  regexRule     OidcRegexRule? @relation(fields: [regexRuleId], references: [id])

  @@unique([applicationId, name])
  @@index([applicationId])
  @@map("oidc_claims")
}

model OidcRegexRule {
  id            String      @id @default(uuid())
  applicationId String
  name          String
  pattern       String
  replacement   String
  flags         String      @default("g")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  claims        OidcClaim[]
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, name])
  @@index([applicationId])
  @@map("oidc_regex_rules")
}

model OidcSigningKey {
  id            String       @id @default(uuid())
  applicationId String
  kid           String
  algorithm     JwsAlgorithm @default(RS256)
  publicKey     String
  privateKey    String
  certChain     String?
  isDefault     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, kid])
  @@index([applicationId])
  @@map("oidc_signing_keys")
}

model OidcTokenPolicy {
  id                   String      @id @default(uuid())
  applicationId        String      @unique
  accessTokenLifetime  Int         @default(3600)
  idTokenLifetime      Int         @default(3600)
  refreshTokenLifetime Int         @default(2592000)
  rotationEnabled      Boolean     @default(true)
  reuseInterval        Int         @default(30)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  application          Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("oidc_token_policies")
}

enum DirectoryType {
  SCIM
  LDAP
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ChallengeType {
  MAGIC_LINK
  EMAIL_OTP
  SMS_OTP
  PASSWORD_RESET
}

enum OrgPlan {
  FREE
  STARTER
  BUSINESS
  ENTERPRISE
}

enum OrgStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  DELETED
}

enum OrgRole {
  SUPER_ADMIN
  ORG_ADMIN
  APP_ADMIN
  USER_ADMIN
  GROUP_MEMBERSHIP_ADMIN
  HELP_DESK_ADMIN
  MOBILE_ADMIN
  READ_ONLY_ADMIN
  REPORT_ADMIN
  API_ACCESS_MANAGEMENT_ADMIN
}

enum MemberStatus {
  ACTIVE
  PENDING_INVITATION
  SUSPENDED
}

enum ApplicationProtocol {
  OIDC
  SAML
}

enum AppStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum SsoProviderType {
  OKTA
  AZURE_AD
  GOOGLE_WORKSPACE
  GENERIC_SAML
  GENERIC_OIDC
}

enum SsoProtocol {
  SAML2
  OIDC
}

enum PolicyType {
  ACCESS
  SIGN_ON
  MFA
  PASSWORD
}

enum PolicyEffect {
  ALLOW
  DENY
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

enum MfaType {
  TOTP
}

enum ClaimTarget {
  ID_TOKEN
  ACCESS_TOKEN
  USERINFO
}

enum JwsAlgorithm {
  RS256
  ES256
}
