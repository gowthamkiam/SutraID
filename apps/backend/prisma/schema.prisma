// SutraID - Prisma Schema
// Simplified schema for prototype (User authentication only)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ============================================================================
// CORE TABLES (Prototype)
// ============================================================================

// User table - Core user identity
model User {
  id                String   @id @default(uuid())
  email             String   @unique
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  role              OrgRole  @default(READ_ONLY_ADMIN)
  emailVerified     Boolean  @default(false)
  emailVerifiedAt   DateTime?

  // Profile
  firstName         String?
  lastName          String?
  avatarUrl         String?

  // Password (nullable — passwordless users don't have one)
  passwordHash      String?
  passwordChangedAt DateTime?
  mustChangePassword Boolean @default(false)

  // Status
  status            UserStatus @default(ACTIVE)
  lastLoginAt       DateTime?

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // MFA (Phase 6)
  mfaEnabled        Boolean  @default(false)

  // Directory / External Identity (SCIM/LDAP)
  externalId        String?  // ID from external directory
  agentMetadata     Json?    // Metadata for AI agents

  // Relations
  authChallenges    AuthChallenge[]
  sessions          Session[]
  organizationMembers OrganizationMember[]
  ssoIdentities     SsoIdentity[]
  mfaMethods        MfaMethod[]
  groups            GroupMember[]
  userGroups        UserGroup[]
  applicationAssignments UserApplicationAssignment[]

  @@index([email])
  @@index([organizationId])
  @@index([status])
  @@index([externalId])
  @@map("users")
}

// ... (UserStatus, AuthChallenge, ChallengeType, Session, OrgPlan, OrgStatus enums and models)

// ============================================================================
// DIRECTORY INTEGRATION (SCIM & LDAP)
// ============================================================================

// DirectoryConfig - Multi-tenant directory configuration
model DirectoryConfig {
  id                String   @id @default(uuid())
  organizationId    String   @unique
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Directory type
  type              DirectoryType @default(SCIM)
  enabled           Boolean  @default(true)

  // SCIM Configuration
  scimToken         String?  // Hashed bearer token
  
  // LDAP Configuration
  ldapUrl           String?  // ldaps://hostname:636
  ldapBaseDn        String?
  ldapBindDn        String?
  ldapBindPassword  String?  // Encrypted
  ldapUserFilter    String?  @default("(objectClass=user)")
  ldapGroupFilter   String?  @default("(objectClass=group)")

  // Sync Settings
  syncInterval      Int      @default(60) // Minutes
  lastSyncAt        DateTime?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([organizationId])
  @@map("directory_configs")
}

enum DirectoryType {
  SCIM
  LDAP
}

// Group - User groups (synced from directory or local)
model Group {
  id                String   @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name              String
  description       String?
  externalId        String?  // ID from external directory (SCIM/LDAP)

  // Relations
  members           GroupMember[]
  userGroups        UserGroup[]
  applicationAssignments GroupApplicationAssignment[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([externalId])
  @@map("groups")
}

model UserGroup {
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId           String
  group             Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@id([userId, groupId])
  @@index([groupId])
  @@index([userId])
  @@map("user_groups")
}

// GroupMember - Junction table for Groups and Users
model GroupMember {
  id                String   @id @default(uuid())
  groupId           String
  group             Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("group_members")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// AuthChallenge - For passwordless authentication (magic links, OTP)
model AuthChallenge {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Challenge details
  type              ChallengeType
  token             String   @unique  // Hashed token for magic links, or OTP code
  identifier        String            // Email or phone number used

  // Verification
  verified          Boolean  @default(false)
  verifiedAt        DateTime?
  attempts          Int      @default(0)
  maxAttempts       Int      @default(3)

  // Expiration
  expiresAt         DateTime

  // Metadata
  ipAddress         String?
  userAgent         String?

  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("auth_challenges")
}

enum ChallengeType {
  MAGIC_LINK
  EMAIL_OTP
  SMS_OTP
  PASSWORD_RESET
}

// Session - User session management
model Session {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Session tokens
  accessToken       String   @unique  // JWT ID (jti claim)
  refreshToken      String   @unique  // Hashed refresh token

  // Device info
  deviceId          String?
  deviceName        String?
  deviceType        String?
  ipAddress         String?
  userAgent         String?
  location          String?

  // Status
  revoked           Boolean  @default(false)
  revokedAt         DateTime?
  revokedReason     String?

  // Expiration
  expiresAt         DateTime
  lastActiveAt      DateTime @default(now())

  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([accessToken])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================================
// MULTI-TENANCY (Phase 1 - Enterprise Features)
// ============================================================================

// Organization (Tenant) - Multi-tenant entity
model Organization {
  id                String   @id @default(uuid())

  // Basic info
  name              String   @unique
  slug              String   @unique  // URL-safe identifier
  domain            String?  @unique  // Primary verified domain

  // Branding
  logoUrl           String?
  primaryColor      String   @default("#000000")

  // Settings
  allowedDomains    String[]  // Email domains that can auto-join

  // Subscription & Limits
  plan              OrgPlan  @default(FREE)
  status            OrgStatus @default(ACTIVE)
  maxMembers        Int      @default(10)
  maxApplications   Int      @default(3)

  // SAML Identity Provider (Phase 3)
  samlIdpCertificate String?  // X.509 certificate for signing SAML assertions
  samlIdpPrivateKey  String?  // Private key (encrypted with AES-256-GCM)

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  users             User[]
  members           OrganizationMember[]
  applications      Application[]
  ssoProviders      SsoProvider[]
  policies          Policy[]
  networkZones      NetworkZone[]
  groups            Group[]
  passwordPolicies  PasswordPolicy[]
  directoryConfig   DirectoryConfig?
  settings          OrganizationSetting[]
  
  // OIDC Provider configurations (Phase 3+)
  oidcScopes        OidcScope[]
  oidcClaims        OidcClaim[]
  oidcRegexRules    OidcRegexRule[]
  oidcSigningKeys   OidcSigningKey[]
  oidcTokenPolicy   OidcTokenPolicy?

  @@index([slug])
  @@index([domain])
  @@map("organizations")
}

// Organization Setting - Key-value pair configuration
model OrganizationSetting {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  key            String       // e.g., "dashboard.tabs.sso.visible"
  value          String       @db.Text
  
  updatedBy      String?      // User ID of the admin who updated it
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("organization_settings")
}

enum OrgPlan {
  FREE
  STARTER
  BUSINESS
  ENTERPRISE
}

enum OrgStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  DELETED
}

// Organization Member - Users belonging to organizations with roles
model OrganizationMember {
  id                String   @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Role-based access control
  role              OrgRole  @default(READ_ONLY_ADMIN)

  // Status
  status            MemberStatus @default(ACTIVE)
  invitedBy         String?  // UserId who sent invitation
  invitedAt         DateTime?
  joinedAt          DateTime @default(now())

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

enum OrgRole {
  SUPER_ADMIN                   // Full control, can delete org
  ORG_ADMIN                     // Manage members, apps, policies
  APP_ADMIN                     // Manage apps and integrations
  USER_ADMIN                    // Manage users
  GROUP_MEMBERSHIP_ADMIN        // Manage groups
  HELP_DESK_ADMIN               // Reset passwords, unlock users
  MOBILE_ADMIN                  // Manage mobile app configs
  READ_ONLY_ADMIN               // Read-only access
  REPORT_ADMIN                  // Audit logs and reports
  API_ACCESS_MANAGEMENT_ADMIN   // Manage API keys and integrations
}

enum MemberStatus {
  ACTIVE
  PENDING_INVITATION
  SUSPENDED
}

// Application - Apps that organizations want to protect
model Application {
  id                String   @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Basic info
  name              String
  description       String?
  logoUrl           String?
  type              ApplicationProtocol @default(OIDC)

  // OAuth/OIDC settings (OAuth 2.1 aligned)
  clientId          String?   @unique
  clientSecretHash  String?   // Hashed
  redirectUris      Json      @default("[]") // Allowed redirect URIs
  grantTypes        Json      @default("[\"authorization_code\", \"refresh_token\"]")
  responseTypes     Json      @default("[\"code\"]")
  scopes            Json      @default("[\"openid\", \"profile\", \"email\"]")
  tokenEndpointAuthMethod String @default("client_secret_post")
  isPublicClient    Boolean   @default(false)
  
  // Security Features
  requireDpop       Boolean   @default(false)
  jwks               Json?     // For DPoP-bound clients or AI Agents
  dpopNonceEnabled   Boolean   @default(true)
  
  // AI Agent specific
  isAiAgent         Boolean   @default(false)

  // SAML Identity Provider Configuration
  samlEntityId       String?
  samlCertificate    String?   @db.Text
  samlPrivateKey     String?   @db.Text
  samlSpEntityId     String?   // External SP's Entity ID
  samlSpAcsUrl       String?   // External SP's Assertion Consumer Service URL
  samlNameIdFormat   String?   @default("urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress")
  samlAttributeMapping Json?   // Map our attributes to SP's expected attributes

  // Status and Metadata
  status            AppStatus @default(ACTIVE)
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  userAssignments   UserApplicationAssignment[]
  groupAssignments  GroupApplicationAssignment[]

  @@index([organizationId])
  @@index([clientId])
  @@map("applications")
}

model UserApplicationAssignment {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())

  @@unique([userId, applicationId])
  @@index([applicationId])
  @@index([userId])
  @@map("user_application_assignments")
}

model GroupApplicationAssignment {
  id             String      @id @default(uuid())
  groupId        String
  group          Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())

  @@unique([groupId, applicationId])
  @@index([applicationId])
  @@index([groupId])
  @@map("group_application_assignments")
}

enum ApplicationProtocol {
  OIDC
  SAML
}

enum AppStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

// ============================================================================
// SSO (Phase 2 - External Identity Providers)
// ============================================================================

// SSO Provider - External SAML/OIDC identity providers
model SsoProvider {
  id                String   @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Provider details
  name              String
  type              SsoProviderType
  protocol          SsoProtocol

  // SAML Configuration
  samlEntityId      String?  // SAML Entity ID (IdP)
  samlSsoUrl        String?  // SAML Single Sign-On URL
  samlCertificate   String?  // X.509 Certificate (encrypted)
  samlMetadataUrl   String?  // SAML Metadata URL

  // OIDC Configuration
  oidcIssuer        String?  // OIDC Issuer URL
  oidcClientId      String?  // OIDC Client ID
  oidcClientSecret  String?  // OIDC Client Secret (encrypted)
  oidcAuthUrl       String?  // Authorization endpoint
  oidcTokenUrl      String?  // Token endpoint
  oidcUserinfoUrl   String?  // UserInfo endpoint
  oidcScopes        String[] @default(["openid", "profile", "email"])

  // Attribute Mapping (JSON)
  // Maps external attributes to internal user fields
  // Example: { "email": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress" }
  attributeMapping  Json     @default("{}")

  // Settings
  enabled           Boolean  @default(true)
  autoProvision     Boolean  @default(true)  // Auto-create users on first login
  allowedDomains    String[] @default([])    // Restrict to specific email domains

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  identities        SsoIdentity[]

  @@index([organizationId])
  @@index([organizationId, enabled])
  @@map("sso_providers")
}

enum SsoProviderType {
  OKTA
  AZURE_AD
  GOOGLE_WORKSPACE
  GENERIC_SAML
  GENERIC_OIDC
}

enum SsoProtocol {
  SAML2
  OIDC
}

// SSO Identity - Links users to external SSO identities
model SsoIdentity {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ssoProviderId     String
  ssoProvider       SsoProvider @relation(fields: [ssoProviderId], references: [id], onDelete: Cascade)

  // External identity details
  externalId        String   // Subject ID from IdP (sub claim or NameID)
  externalEmail     String?  // Email from IdP
  issuer            String   // Issuer URL or Entity ID

  // Attributes from IdP (JSON)
  attributes        Json     @default("{}")

  // First and last login tracking
  firstLoginAt      DateTime @default(now())
  lastLoginAt       DateTime @default(now())

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([ssoProviderId, externalId])
  @@index([userId])
  @@index([ssoProviderId])
  @@map("sso_identities")
}

// ============================================================================
// OIDC IDENTITY PROVIDER (Phase 3)
// ============================================================================

// OidcToken - Stores OIDC Provider tokens (authorization codes, access tokens, etc.)
// Used by oidc-provider library
model OidcToken {
  id                String   @id @default(uuid())
  organizationId    String

  // Token type (AuthorizationCode, AccessToken, RefreshToken, etc.)
  type              String

  // Token identifier (from oidc-provider)
  tokenId           String

  // Serialized payload (JSON)
  payload           String   @db.Text

  // Expiration
  expiresAt         DateTime

  // Consumption tracking
  consumed          Boolean  @default(false)
  consumedAt        DateTime?

  createdAt         DateTime @default(now())

  @@unique([organizationId, type, tokenId])
  @@index([organizationId, type])
  @@index([expiresAt])
  @@map("oidc_tokens")
}

// ============================================================================
// POLICY ENGINE (Phase 4)
// ============================================================================

// Policy - Fine-grained authorization rules
model Policy {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Policy details
  name            String
  description     String?
  type            PolicyType   @default(ACCESS)
  effect          PolicyEffect @default(ALLOW)
  
  // Resources and Actions (ABAC)
  resource        String       @default("*")
  actions         String[]     @default([])
  
  // Rules for Sign-on/Auth policies (JSON array of rules)
  // Example: [{ "priority": 1, "conditions": { "group": "Admins" }, "requirement": "MFA_REQUIRED" }]
  rules           Json         @default("[]")

  // Context conditions (JSON) - Legacy/Generic
  conditions      Json         @default("{}")

  // Evaluation order
  priority        Int          @default(0)
  enabled         Boolean      @default(true)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, enabled])
  @@map("policies")
}

enum PolicyType {
  ACCESS
  SIGN_ON
  MFA
  PASSWORD
}

// PasswordPolicy - Complexity and rotation rules
model PasswordPolicy {
  id              String       @id @default(uuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  minLength       Int          @default(8)
  requireUppercase Boolean     @default(true)
  requireLowercase Boolean     @default(true)
  requireNumbers   Boolean     @default(true)
  requireSymbols   Boolean     @default(true)
  
  maxAgeDays      Int          @default(0) // 0 = never expire
  historyCount    Int          @default(5) // Don't allow reuse of last 5 passwords
  
  lockoutThreshold Int         @default(5) // Lock after 5 failed attempts
  lockoutDuration  Int         @default(30) // Minutes

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("password_policies")
}

enum PolicyEffect {
  ALLOW
  DENY
}

// NetworkZone - IP/geo-based access zones
model NetworkZone {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name            String
  description     String?
  ipRanges        String[]     // CIDR blocks (e.g., ["10.0.0.0/8", "192.168.1.0/24"])
  geoLocations    String[]     // ISO country codes (e.g., ["US", "CA", "GB"])
  trusted         Boolean      @default(false)
  enabled         Boolean      @default(true)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
  @@map("network_zones")
}

// ============================================================================
// AUDIT LOGGING (Phase 5)
// ============================================================================

// AuditLog - Immutable audit trail for compliance
model AuditLog {
  id              String       @id @default(uuid())
  organizationId  String?
  userId          String?
  agentId         String?      // For AI agent actions (Phase 7)

  // Event details
  action          String       // "user.login", "user.register", "token.issued", "policy.evaluated", "sso.login"
  resource        String?      // What was accessed/modified
  result          AuditResult  @default(SUCCESS)

  // Context metadata (JSON)
  // { "ipAddress": "...", "userAgent": "...", "method": "password", "provider": "okta" }
  metadata        Json         @default("{}")

  // Risk scoring (anomaly detection placeholder)
  riskScore       Float?

  // Immutable timestamp
  createdAt       DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
  @@index([result])
  @@map("audit_logs")
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

// ============================================================================
// MFA (Phase 6)
// ============================================================================

// MfaMethod - Multi-factor authentication methods per user
model MfaMethod {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Method details
  type              MfaType  @default(TOTP)
  name              String   @default("Authenticator App")

  // TOTP configuration (encrypted with AES-256-GCM)
  totpSecret        String?  // Encrypted Base32 secret
  totpEncryptionIv  String?  // AES-GCM initialization vector
  totpAuthTag       String?  // AES-GCM authentication tag

  // Backup codes (bcrypt hashed)
  backupCodes       String[]

  // Status
  verified          Boolean  @default(false)
  enabled           Boolean  @default(true)

  // Metadata
  lastUsedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([userId, enabled])
  @@map("mfa_methods")
}

enum MfaType {
  TOTP
}

// ============================================================================
// FUTURE TABLES (Phase 7+)
// ============================================================================

// Phase 7: Agent, AgentToken models
// Phase 8: McpServer model
// Future: Identity (social OAuth), ApiKey

// ============================================================================
// OIDC PROVIDER CONFIGURATION (OAuth 2.1 & Multi-tenant Claims)
// ============================================================================

// OidcScope - Custom scopes per organization
model OidcScope {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name           String       // e.g., "read:orders"
  description    String?
  isDefault      Boolean      @default(false)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("oidc_scopes")
}

// OidcClaim - Claim definitions mapping user attributes to tokens
model OidcClaim {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name               String       // Claim name in the token
  userAttribute      String       // Path to user attribute (e.g., "firstName", "metadata.custom_field")
  
  // Transformation
  regexRuleId        String?
  regexRule          OidcRegexRule? @relation(fields: [regexRuleId], references: [id], onDelete: SetNull)
  
  // Visibility
  targetTokens       ClaimTarget[] // ["ID_TOKEN", "ACCESS_TOKEN", "USERINFO"]
  
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("oidc_claims")
}

enum ClaimTarget {
  ID_TOKEN
  ACCESS_TOKEN
  USERINFO
}

// OidcRegexRule - Regex transformations for claims
model OidcRegexRule {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name           String
  pattern        String
  replacement    String
  flags          String       @default("g")
  
  claims         OidcClaim[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("oidc_regex_rules")
}

// OidcSigningKey - Organization-specific JWS signing keys
model OidcSigningKey {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  kid            String       // Key ID (kid)
  algorithm      JwsAlgorithm @default(RS256)
  publicKey      String       @db.Text
  privateKey     String       @db.Text // Encrypted (AES-256-GCM)
  certChain      String?      @db.Text // Optional custom X.509 certificate chain
  
  isDefault      Boolean      @default(false)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, kid])
  @@index([organizationId])
  @@map("oidc_signing_keys")
}

enum JwsAlgorithm {
  RS256
  ES256
}

// OidcTokenPolicy - Token lifetime and behaviors
model OidcTokenPolicy {
  id                   String       @id @default(uuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  accessTokenLifetime  Int          @default(3600)    // Seconds
  idTokenLifetime     Int          @default(3600)    // Seconds
  refreshTokenLifetime Int          @default(2592000) // 30 days
  
  rotationEnabled      Boolean      @default(true)
  reuseInterval        Int          @default(30)      // Clock skew/reuse grace (seconds)
  
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@map("oidc_token_policies")
}
