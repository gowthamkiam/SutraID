########################################
# SutraID Monorepo - Environment Template
# --------------------------------------
# Copy this file to `.env` and replace the
# placeholder values with your own secrets.
########################################

# Core
NODE_ENV=development

########################################
# Backend API (apps/backend)
########################################

# Database (local PostgreSQL by default; Neon-compatible in production)
# For local docker-compose this is usually:
#   postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@db:5432/$POSTGRES_DB
DATABASE_URL="postgresql://sutraid:change_me@localhost:5432/sutraid"

# Optional: direct connection string for migrations against managed Postgres (e.g. Neon)
DIRECT_DATABASE_URL="postgresql://user:password@your-neon-host.neon.tech/your-db?sslmode=require"

# JWT / session configuration
JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Email (Resend or any SMTP provider)
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="noreply@example.com"

# Backend server config
PORT=3000
API_PREFIX="api/v1"

# URLs used by the backend
FRONTEND_URL="http://localhost:3001"
ADMIN_DASHBOARD_URL="http://localhost:3001"
BACKEND_URL="http://localhost:3000"
MAGIC_LINK_BASE_URL="http://localhost:3001/auth/verify"

# Encryption key for sensitive data (32 bytes hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your_32_byte_hex_key_here"

########################################
# Frontend (apps/web)
########################################

# Public API URL consumed by the Next.js app
# For local docker-compose this will usually be:
#   http://localhost:3000/api/v1  (host)
#   http://backend:3000/api/v1    (from inside the Docker network)
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

########################################
# Local Postgres (docker-compose)
########################################

# These are used only by docker-compose for the `db` service.
# They are NOT committed and can be changed safely for local use.
POSTGRES_DB="sutraid"
POSTGRES_USER="sutraid"
POSTGRES_PASSWORD="change_me"

########################################
# Optional Integrations
########################################

# Redis (e.g. Upstash) for rate limiting / sessions
# REDIS_URL="redis://default:your_password@your-redis.upstash.io:6379"

# Twilio (for SMS OTP)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""

