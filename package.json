{
  "name": "sutraid",
  "version": "0.1.0",
  "private": true,
  "description": "AI-native CIAM platform - The only authentication system built for both humans AND AI agents",
  "keywords": [
    "auth",
    "authentication",
    "ciam",
    "passwordless",
    "mcp",
    "ai-native",
    "oauth2",
    "multi-tenant"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.2.4",
    "prisma": "^5.8.0",
    "turbo": "^1.11.3",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.1"
}
